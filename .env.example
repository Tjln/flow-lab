# URL du webhook n8n qui recoit tous les leads du site.
# n8n Cloud : https://<votre-espace>.app.n8n.cloud/webhook/flowlab-lead
N8N_WEBHOOK_URL=

# Secret partage entre le site et n8n. Le workflow doit rejeter toute
# requete dont l'en-tete X-Flowlab-Secret ne correspond pas.
N8N_WEBHOOK_SECRET=

# URL publique du site (metadonnees SEO et partages sociaux).
NEXT_PUBLIC_SITE_URL=https://flow-lab.vercel.app
