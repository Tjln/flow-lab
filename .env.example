# URL du webhook n8n qui recoit tous les leads du site.
# n8n Cloud : https://<votre-espace>.app.n8n.cloud/webhook/flowlab-lead
N8N_WEBHOOK_URL=

# Webhook n8n qui compte les telechargements. Facultatif : sans lui, les
# fichiers restent telechargeables, seule la statistique est perdue.
N8N_WEBHOOK_TELECHARGEMENT_URL=

# Secret partage entre le site et n8n. Le workflow doit rejeter toute
# requete dont l'en-tete X-Flowlab-Secret ne correspond pas.
N8N_WEBHOOK_SECRET=

# URL publique du site (metadonnees SEO et partages sociaux).
# Facultatif : sur Vercel, le domaine de production est detecte automatiquement.
# A renseigner uniquement le jour ou un vrai nom de domaine sera pose.
NEXT_PUBLIC_SITE_URL=
